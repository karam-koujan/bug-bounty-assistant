# ---------------------------------------------------------------------------
# AI provider (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Provider adapter: openai | anthropic | generic | openrouter
# "generic" means any OpenAI-compatible /chat/completions endpoint
# (OpenRouter, Groq, Together, LM Studio, Ollama, ...).
# For OpenRouter, set AI_PROVIDER=generic and AI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER=generic

# Required for openai and anthropic. Optional for generic/local endpoints.
AI_API_KEY=your-openrouter-key-here

# Model id exposed by the provider.
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# Base URL, without a trailing slash.
# Set this explicitly for openai/anthropic in this build.
#   OpenAI:     https://api.openai.com/v1
#   Anthropic:  https://api.anthropic.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://127.0.0.1:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# Only used by the generic provider. Defaults to /chat/completions.
# AI_API_PATH=/chat/completions

# Reserved. Not currently applied to provider requests.
AI_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file path, relative to the project root.
DATABASE_URL=file:./dev.db

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
